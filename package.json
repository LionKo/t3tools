{
  "name": "t3tools",
  "version": "0.1.6",
  "description": "Windows T3 Code 原生增强插件：上下文/缓存/实时速度监控、运行阶段与多模型组额度卡片、周限额周期用量看板、53周热力图与异常掉缓存排查",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.13.0"
  },
  "bin": {
    "t3tools": "./bin/t3tools.mjs"
  },
  "scripts": {
    "start": "node ./bin/t3tools.mjs start",
    "tray": "node ./bin/t3tools.mjs tray",
    "build-tray": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/build-tray.ps1",
    "build-release": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/build-release.ps1",
    "status": "node ./bin/t3tools.mjs status",
    "doctor": "node ./bin/t3tools.mjs doctor",
    "patch-debug": "node ./bin/t3tools.mjs patch-debug",
    "install-launcher": "node ./bin/t3tools.mjs install",
    "uninstall-launcher": "node ./bin/t3tools.mjs uninstall",
    "test": "node --test tests/*.test.mjs"
  }
}
